.post-body blockquote {
  margin: 1em 0;
  padding: 1em 1em;
  background: #edf2f8;
  border-left: 4px solid #64748b;
  border-radius: 3px;
  color: #3b3c52f0;
  overflow-x: auto;
}

.post-body blockquote p:first-child {
  margin-top: 0;
}

.post-body blockquote p:last-child {
  margin-bottom: 0;
}

.post-body hr {
  height: 0;
  background: none;
  background-image: none;
  border: none; 
  
  width: 100%;
  margin: 1em auto;
  border-top: 3px dashed #64748b;
}
