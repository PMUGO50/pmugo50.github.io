.post-body hr {
  height: 0;
  background: none;
  background-image: none;
  border: none; 
  
  width: 100%;
  margin: 1em auto;
  border-top: 3px dashed #64748b;
}

.post-body p a {
  color: #083789; 
  border-bottom: none;
  &:hover {
    color: #5ca6fb; 
    border-bottom: 1px solid #5ca6fb;
  }
}

// ---------- 基础 ----------
.post-body .note,
.note
  border-radius: 6px
  padding: 12px 16px

  .note-title
    margin: 0 0 6px
    font-size: 1em
    font-weight: 600

// ---------- primary ----------
.post-body .note.primary,
.note.primary
  background-color: #edf2f8
  border-left-color: #64748b

  > i
    color: #64748b

.post-body .note.primary::before,
.post-body .note.primary::after,
.note.primary::before,
.note.primary::after
  background-color: #edf2f8
  border-left-color: #64748b

// ---------- info ----------
.post-body .note.info,
.note.info
  background-color: #edf8ed
  border-left-color: #648b6b

  > i
    color: #648b6b

.post-body .note.info::before,
.post-body .note.info::after,
.note.info::before,
.note.info::after
  background-color: #edf8ed
  border-left-color: #648b6b

// ---------- warning ----------
.post-body .note.warning,
.note.warning
  background-color: #f8f8ed
  border-left-color: #8b8764

  > i
    color: #8b8764

.post-body .note.warning::before,
.post-body .note.warning::after,
.note.warning::before,
.note.warning::after
  background-color: #f8f8ed
  border-left-color: #8b8764

// ---------- danger ----------
.post-body .note.danger,
.note.danger
  background-color: #f8eded
  border-left-color: #8b6464

  > i
    color: #8b6464

.post-body .note.danger::before,
.post-body .note.danger::after,
.note.danger::before,
.note.danger::after
  background-color: #f8eded
  border-left-color: #8b6464

.post-body .note,
.note
  color: #3b3c52f0

  // 段落、列表、加粗都要跟随
  p, li, strong, em, span
    color: inherit