.post-body hr {
  height: 0;
  background: none;
  background-image: none;
  border: none; 
  
  width: 100%;
  margin: 1em auto;
  border-top: 3px dashed #64748b;
}

.post-body p a {
  color: #417FBE; 
  border-bottom: none;
  &:hover {
    color: #E6A3B3; 
    border-bottom: 1px solid #E6A3B3;
  }
}

/* 1. 常规体 Regular (字重 400，正常体) */
@font-face {
  font-family: 'Source Serif 4';
  src: url('/fonts/source-serif-4-regular.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* 2. 粗体 Bold (字重 700，正常体) */
@font-face {
  font-family: 'Source Serif 4';
  src: url('/fonts/source-serif-4-bold.woff2') format('woff2');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

/* 3. 斜体 Italic (字重 400，斜体) */
@font-face {
  font-family: 'Source Serif 4';
  src: url('/fonts/source-serif-4-italic.woff2') format('woff2');
  font-weight: 400;
  font-style: italic;
  font-display: swap;
}

/* 4. 粗斜体 Bold Italic (字重 700，斜体) */
@font-face {
  font-family: 'Source Serif 4';
  src: url('/fonts/source-serif-4-bold-italic.woff2') format('woff2');
  font-weight: 700;
  font-style: italic;
  font-display: swap;
}

// ---------- 基础 ----------
.post-body .note,
.note
  border-radius: 6px
  padding: 12px 16px

  .note-title
    margin: 0 0 6px
    font-size: 1em
    font-weight: 600

// ---------- primary ----------
.post-body .note.primary,
.note.primary
  background-color: #edf2f8
  border-left-color: #64748b

  > i
    color: #64748b

.post-body .note.primary::before,
.post-body .note.primary::after,
.note.primary::before,
.note.primary::after
  background-color: #edf2f8
  border-left-color: #64748b

// ---------- info ----------
.post-body .note.info,
.note.info
  background-color: #f6edf8
  border-left-color: #7d648b

  > i
    color: #648b6b

.post-body .note.info::before,
.post-body .note.info::after,
.note.info::before,
.note.info::after
  background-color: #edf8ed
  border-left-color: #648b6b

// ---------- warning ----------
.post-body .note.warning,
.note.warning
  background-color: #f8f8ed
  border-left-color: #8b7d64

  > i
    color: #8b7d64

.post-body .note.warning::before,
.post-body .note.warning::after,
.note.warning::before,
.note.warning::after
  background-color: #f8f8ed
  border-left-color: #8b7d64

// ---------- danger ----------
.post-body .note.danger,
.note.danger
  background-color: #f8edf1
  border-left-color: #725555

  > i
    color: #725555

.post-body .note.danger::before,
.post-body .note.danger::after,
.note.danger::before,
.note.danger::after
  background-color: #f8edf1
  border-left-color: #725555

.post-body .note,
.note
  color: #3b3c52f0

  // 段落、列表、加粗都要跟随
  p, li, strong, em, span
    color: inherit