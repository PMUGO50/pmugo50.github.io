.post-body blockquote {
  margin: 1em 0;
  padding: 1em 1em;
  background: #e5f0ff;
  border-left: 4px solid #0f1978;
  border-radius: 3px;
  color: #171c3dd8;
  overflow-x: auto;
}

.post-body blockquote p:first-child {
  margin-top: 0;
}

.post-body blockquote p:last-child {
  margin-bottom: 0;
}

.post-body hr {
  height: 0;
  background: none;
  background-image: none;
  border: none; 
  
  width: 100%;
  margin: 1em auto;
  border-top: 3px dashed #0f1978;
}